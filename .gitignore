# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
# 项目内 npm 缓存（沙箱内安装依赖时使用，避免写入外接盘共享缓存）
/.npm-cache
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# 所有含密码的本地环境变量文件一律不提交
.env*
!.env.example

# 本地凭据文件（只读用户密码等）
.pg-credentials.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
