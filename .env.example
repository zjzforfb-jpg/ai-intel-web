# 依赖环境变量（真实值在 .env.local，从 n8n-radar/.env 同步，不在此文件存放密码）
DB_HOST=postgres
DB_PORT=5432
DB_USER=ai_intel_reader
DB_PASSWORD=从 n8n-radar/.env 的 WEB_DB_PASSWORD 读取
DB_NAME=ai_intelligence
DISPLAY_TZ=Asia/Shanghai

# 写入账号（仅 topics / opportunities 两张表 CRUD，daily_reports 只读）
DB_WRITE_USER=ai_intel_writer
DB_WRITE_PASSWORD=从 n8n-radar/.env 的 WEB_WRITE_PASSWORD 读取

# 监控账号（业务表只读 + monitor_runs/monitor_notifications CRUD）
DB_MONITOR_USER=ai_intel_monitor
DB_MONITOR_PASSWORD=从 n8n-radar/.env 的 WEB_MONITOR_PASSWORD 读取

# 异常通知（通用 Webhook，如企业微信/飞书/Slack incoming webhook；留空则只记录不通知）
MONITOR_WEBHOOK_URL=
# 单次检查超时（毫秒）
MONITOR_CHECK_TIMEOUT_MS=60000
